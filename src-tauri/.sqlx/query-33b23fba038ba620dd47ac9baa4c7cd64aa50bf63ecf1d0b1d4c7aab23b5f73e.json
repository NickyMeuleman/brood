  "query": "\n        SELECT\n            l.id,\n            l.parent_lot_id,\n            l.source_trade_id,\n            l.qty_at_acquisition,\n            l.price_per_unit,\n            t.executed_at AS \"executed_at: NaiveDateTime\"  -- NULL for CA lots\n        FROM lot l\n        LEFT JOIN trade t ON t.id = l.source_trade_id\n        ORDER BY l.id ASC\n        ",
