  "db_name": "SQLite",
  "query": "\n        SELECT \n            l.id,\n            l.qty_at_acquisition,\n            l.listing_id,\n            l.price_per_unit,\n            li.currency_code,\n            li.ticker,\n            li.exchange_mic,\n            i.name,\n            i.isin,\n            i.instrument_type as \"instrument_type: InstrumentType\"\n        FROM lot l\n        JOIN listing li ON li.id = l.listing_id\n        JOIN instrument i ON i.id = l.instrument_id\n        WHERE l.id NOT IN (SELECT lot_id FROM lot_close)\n        ",
